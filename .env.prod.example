# Production environment variables for docker-compose.prod.yml
# Copy to .env.prod and fill in real values.
# docker-compose will load these via `--env-file .env.prod`.

# MongoDB (server creates an authenticated user on first boot)
MONGO_ROOT_USER=findthegame
MONGO_ROOT_PASS=replace-with-strong-password

# Server
JWT_SECRET=replace-with-a-random-string-at-least-32-chars-long
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_ORIGIN=https://localhost

# Web Push (run `npx web-push generate-vapid-keys` to get a pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# Optional: sports data sync script
RAPIDAPI_KEY=
